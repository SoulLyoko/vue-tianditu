{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@vue-tianditu/types": ["./packages/types/types.d.ts"],
      "@vue-tianditu/core": ["./packages/core/index.ts"],
      "@vue-tianditu/components": ["./packages/components/index.ts"],
      "vue-tianditu": ["./packages/vue-tianditu/index.ts"]
    }
  },
  "include": ["src", "packages"]
}
