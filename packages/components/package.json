{
  "name": "@vue-tianditu/components",
  "version": "3.0.0",
  "description": "Vue 3 components for Tianditu",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./*": "./*"
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@vue-tianditu/core": "workspace:^",
    "@vue-tianditu/types": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "sass": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peer"
  }
}
